# URL de l'API consommée par le front.
# Défaut si non défini : http://localhost:3000/api
VITE_API_URL="http://localhost:3000/api"

# Supervision — Sentry (facultatif). DSN du projet Sentry "React".
# Laisser vide désactive la capture d'erreurs (no-op). En production, cette
# variable doit être présente AU BUILD : l'ajouter comme secret GitHub Actions
# (workflow deploy-front.yml), car c'est la CI qui build le front.
VITE_SENTRY_DSN=""
