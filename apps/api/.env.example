# Base de données
# Valeur par défaut : la base PostgreSQL locale fournie par `docker compose up -d`
# (voir docker-compose.yml à la racine du repo). Si vous utilisez votre propre
# serveur PostgreSQL, remplacez simplement cette URL.
DATABASE_URL="postgresql://countrytravel:countrytravel@localhost:5432/countrytravel"

# JWT — deux secrets DISTINCTS, à générer chacun (lancer la commande 2 fois) :
#   openssl rand -base64 64
# Sans openssl (ex. PowerShell sous Windows), passer par Node :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# L'API refuse de démarrer si l'un des deux secrets est absent.
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"

# Application
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
