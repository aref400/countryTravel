# Base de données
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT — génère des secrets forts et distincts (ex: openssl rand -base64 64)
# L'API refuse de démarrer si JWT_SECRET est absent.
JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me_too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth Google
GOOGLE_CLIENT_ID="ton_google_client_id"
GOOGLE_CLIENT_SECRET="ton_google_client_secret"

# OAuth GitHub
GITHUB_CLIENT_ID="ton_github_client_id"
GITHUB_CLIENT_SECRET="ton_github_client_secret"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
CALLBACK_URL_BASE="http://localhost:3000"
