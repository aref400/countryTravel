// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  isoCode String @id
  name String
  region String?
  flagUrl String?
  description String?

  countryScoreProfiles CountryScoreProfile?
}

model CountryScoreProfile {
  countryId String @id
  country Country? @relation(fields: [countryId], references: [isoCode])
  @@unique([countryId])
  priceLevel Int?
  safetyLevel Int?
  tourismCrowdLevel Int?
  familyFriendlinessLevel Int?
  partyLevel Int?
  sportLevel Int?
  natureLevel Int?
  cultureLevel Int?
  historyLevel Int?
  adventureLevel Int?
  luxuryLevel Int?
  climateLevel Int?
  bestMonthsFrom Int?
  bestMonthsTo Int?
}

