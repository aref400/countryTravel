{
  "name": "country-travel",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:front": "npm run dev --workspace=apps/front",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:front\"",
    "build:api": "npm run build --workspace=apps/api",
    "build:front": "npm run build --workspace=apps/front",
    "start:api": "npm run start:prod --workspace=apps/api",
    "start:front": "npm run start:prod --workspace=apps/front",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
